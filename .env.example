# QuickBooks Online MCP server — environment template.
# Copy to `.env` and fill in your Intuit Developer app keys. NEVER commit `.env`.
#
#   cp .env.example .env
#
# Get these from https://developer.intuit.com → your app → Keys & OAuth.

# App credentials (Client ID / Secret for your Intuit app).
# These are the PRODUCTION keys, and the default for every company.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=

# Intuit issues separate DEVELOPMENT keys for the same app, and they are the
# only ones that work against sandbox companies (production keys are rejected
# there, and vice versa). Set these if this connector serves sandbox files
# alongside real client books; the pair is chosen per company, from the
# environment recorded in its token file. Leave unset if you only use one.
# QBO_CLIENT_ID_SANDBOX=
# QBO_CLIENT_SECRET_SANDBOX=

# Sandbox localhost callback only. It must match a Redirect URI registered on
# the app's DEVELOPMENT Keys & OAuth page exactly. Production uses the
# Playground or catcher redirect documented below, not this localhost value.
QBO_REDIRECT_URI=http://localhost:3000/callback

# Production authorization. Intuit rejects http://localhost as a redirect URI
# outside development, so a real client company authorizes one of two ways.
#
# RECOMMENDED, nothing to host:
#   npm run connect:playground -- <slug>
#     Mint tokens in Intuit's own OAuth 2.0 Playground and paste the Realm ID
#     and Refresh Token back (input is hidden). One-time app setup: register
#     https://developer.intuit.com/v2/OAuth2Playground/RedirectUrl
#     as a Redirect URI on the app's production Keys & OAuth page.
#     A rotated token is encrypted and fsynced to a hidden recovery sidecar
#     until CompanyInfo verification succeeds; rerun the command to resume an
#     interrupted import instead of minting another token.
#
# ALTERNATIVE, if you would rather host a page:
#   npm run connect:catcher -- <slug>
#     Intuit redirects to a static page that displays the one-time code, and
#     you paste it back. There is NO default page: deploy the one in
#     docs/oauth-catcher/ (see its README), register its HTTPS URL on your
#     Intuit app, and set it here. Must be https://.
# QBO_CATCHER_REDIRECT_URI=

# `sandbox` (Intuit test companies) or `production` (real books).
# This sets the environment used by the localhost `npm run connect` flow, which
# is for sandbox companies. Production uses connect:playground or
# connect:catcher; each company's environment is stored in its token file.
QBO_ENVIRONMENT=sandbox

# Optional: default company for callers that don't pass one. Leave UNSET for the
# unified single-connector setup (you pick the company at runtime with
# select_company / the `company` argument). Set it only for a legacy
# one-connector-per-company setup.
# QBO_COMPANY=

# Optional tuning (defaults shown). QBO_MINOR_VERSION pins the Accounting API
# minor version; Intuit's supported baseline is 75. QBO_TIMEOUT_MS caps each
# API request before it is retried or fails.
# QBO_MINOR_VERSION=75
# QBO_TIMEOUT_MS=60000

# Security & governance (defaults shown).
# QBO_TOKEN_ENCRYPTION=on   # encrypt token files at rest (off = legacy plaintext)
# QBO_TOKEN_KEY=            # optional 64-hex master key override (else OS secret store / .qbo-key file)
# QBO_TOKENS_DIR=           # existing directory for tokens, OAuth recovery state, and authorization locks (default: project root)
# QBO_AUDIT=on              # on | strict | off for the optional accountability
#                           # log. The body-free write-recovery ledger is always
#                           # enabled and fsynced BEFORE a request is sent;
#                           # turning audit off never disables safe replay.
#                           # `strict` makes a later accountability-log failure
#                           # visible but cannot roll back a completed QBO call.
# QBO_AUDIT_DIR=            # override the audit log directory
# QBO_CLOSED_PERIOD=warn    # warn | block | off, for writes dated into a closed period;
#                           # an omitted TxnDate warns, or blocks in block mode,
#                           # because Intuit does not document its server-date timezone
# QBO_POLICY_FILE=          # per-company write policies (default ./qbo-policy.json; see qbo-policy.example.json)
# QBO_CLIENTS_FILE=         # client roster labels (default ./clients.json, gitignored)
# QBO_DISABLE_WRITES=false  # true = hide QBO bookkeeping/outward-write tools (create,
#                           # update, send, void, delete, import, attach, raw/batch POST);
#                           # local session/config/file tools and OAuth administration remain.
#                           # Only literal true/false is accepted, so typos fail startup
# QBO_DISABLE_DELETES=false # true = never register delete/void tools;
#                           # only literal true/false is accepted, so typos fail startup
# QBO_TOOL_PROFILE=core     # core | owner | bookkeeper | accountant | admin | developer | full
#                           # Selected at startup. `core` is the bounded default;
#                           # `accountant` opts into the broad professional surface.
#                           # OAuth/raw API/permanent-delete tools stay hidden, and
#                           # so does set_company_policy: only `accountant`, `admin`,
#                           # `developer` and `full` can edit the write guardrails.
# QBO_PDF_MAX_BYTES=        # size cap for PDF downloads (default 50 MiB)
# QBO_PDF_MAX_INLINE_BYTES= # smaller cap for get_*_pdf inline MCP content (default 5 MiB)
# QBO_RESPONSE_MAX_BYTES=   # cap for any JSON/OAuth response before parsing (default 32 MiB)
# QBO_RETRY_WRITES=false    # true = retry writes on timeouts and 5xx, reusing the
#                           # same Intuit requestid inside the replay-age ceiling.
#                           # Measured in sandbox (a replayed requestid returns
#                           # the original record), but that covered one entity type
#                           # at one point in time, so it stays off by default. With
#                           # it off, an interrupted write reports its request_id.
#                           # Inspect list_unresolved_writes first. Single-request
#                           # tools can replay identical arguments with that id;
#                           # composite workflows use their resume/reconcile path.
# QBO_RECOVERY_REPLAY_MAX_AGE_MS=90000
#                           # hard age ceiling for manual and automatic write replay.
#                           # Intuit publishes no request-id retention guarantee;
#                           # 90 seconds is the longest window verified in one
#                           # sandbox measurement. Raising it accepts unverified
#                           # duplicate-posting risk. Old ids remain permanently
#                           # reserved locally but become reconciliation-only.
# QBO_REPORT_MAX_INLINE_CHARS=  # cap on a report returned inline (default 300,000).
#                           # Past it the tool fails and names the size; use
#                           # export_qbo_artifact to write a file explicitly.
#                           # Detail reports are the reason: CustomerBalanceDetail
#                           # can exceed 3M characters and no date argument
#                           # shrinks it, only a customer/vendor filter does.

# --- Optional hardening (added 2026-08-02) ---
# Restrict every user-supplied local file path (CSV import, attachments,
# reconcile, report/PDF save paths) to one directory tree. Required for every
# file-reading or file-writing workflow; recommended value is the client
# files root. Credential-shaped filenames are refused regardless, and symlinks
# are resolved before the check so a link inside the tree cannot point out of it.
#
# Import, reconciliation, report export, PDF/attachment download, and
# attach_file all require this to be set. The last action uploads a local file
# into QuickBooks, so an unconstrained path would be an exfiltration route.
# QBO_FILES_DIR=~/Claude

# Writes require an explicit `company` argument on every call, ignoring
# select_company/session and env defaults. This is now the DEFAULT: one server
# process serves every open Claude conversation, so a select_company in one
# chat could otherwise retarget a write issued from another. Set it to false
# only for a single-operator setup that wants writes to inherit the defaults.
# QBO_REQUIRE_EXPLICIT_COMPANY=false
