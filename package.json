{
  "name": "qbo-mcp-server",
  "version": "1.1.0",
  "description": "Local MCP server for multi-company QuickBooks Online accounting workflows (read + write).",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "doctor": "node src/doctor.js",
    "start": "node src/index.js",
    "connect": "node src/index.js --connect",
    "connect:batch": "node src/index.js --connect-batch",
    "connect:catcher": "node src/index.js --connect-catcher",
    "connect:playground": "node src/index.js --connect-playground",
    "disconnect": "node src/index.js --disconnect",
    "test": "vitest run"
  },
  "files": [
    "src",
    "README.md",
    "SETUP_GUIDE.md",
    "SECURITY.md",
    "DEVELOPER.md",
    "TESTING.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "NOTICE",
    ".env.example",
    ".claude/skills/add-qbo-company",
    "docs/oauth-catcher",
    "qbo-policy.example.json",
    "claude_desktop_config.snippet.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "vitest": "^4.1.10"
  },
  "license": "Apache-2.0"
}
